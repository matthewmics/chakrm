# Base URL of the API, including the /api prefix.
#
# Traefik routes this host to the API container — see traefik/dynamic.yml and
# the compose labels. Needs the hosts-file entries documented in CLAUDE.md.
# The direct container mapping (http://localhost:3001/api) also works if you
# would rather bypass Traefik.
NEXT_PUBLIC_API_URL=http://api.chakrm.local/api
