# Used by the Prisma CLI (migrate, studio, etc). When running through
# docker compose, the `api` service already gets DATABASE_URL from the
# environment block in docker-compose.yml, so this file is only needed
# if you run Prisma commands outside Docker against the exposed db port.
DATABASE_URL="postgresql://chakrm:chakrm@localhost:5432/chakrm?schema=public"

# --------------------------------------------------------------------------
# Auth. The API reads these from docker-compose.yml, which sources them from a
# root .env — copy the ones you need to override there, not here.
# --------------------------------------------------------------------------

# Signing key for the session JWT. Any non-empty string works locally; generate
# a real one per environment before this leaves a developer machine.
JWT_SECRET="dev-only-insecure-secret-change-me"
JWT_EXPIRES_IN="7d"

# Parent domain of every *.chakrm.local host, so web, admin and the API all
# share one cookie. Cookies ignore ports but not hosts: a browser at
# localhost:3000 will NOT send this cookie. Use http://chakrm.local.
AUTH_COOKIE_DOMAIN=".chakrm.local"

# Google OAuth. Create a "Web application" credential at
# https://console.cloud.google.com/apis/credentials and register the callback
# below as an authorised redirect URI.
#
# It points at localhost, not api.chakrm.local, because Google requires a
# public top-level domain and permits plain http only for localhost. The
# callback therefore cannot set a .chakrm.local cookie directly — it mints a
# one-time code and hands off to WEB_APP_URL, which exchanges it against
# api.chakrm.local. See _tasks/auth-task.md 0.3.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# Where the OAuth handoff redirects back to.
WEB_APP_URL="http://chakrm.local"
